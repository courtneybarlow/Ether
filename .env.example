# Copy each of these into Vercel → Project → Settings → Environment Variables. Never commit real values.

# Who Ether belongs to (only this account can sign in to the server)
OWNER_EMAIL=courtney@example.com

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Ether's brain: console.anthropic.com → API keys
ANTHROPIC_API_KEY=
ETHER_MODEL=claude-sonnet-5-5

# Voice + mic: platform.openai.com → API keys
OPENAI_API_KEY=
ETHER_VOICE=marin
ETHER_TTS_MODEL=gpt-4o-mini-tts
ETHER_STT_MODEL=gpt-4o-mini-transcribe

# Calendars: one per line, "Name | secret iCal link"
CALENDAR_ICS="Personal | https://calendar.google.com/calendar/ical/.../basic.ics"

# Spotify developer app (developer.spotify.com/dashboard). Redirect URI: https://YOUR-ETHER-URL/api/spotify-callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Shopify (optional): Dev Dashboard app credentials, or an Admin API token
SHOPIFY_SHOP=your-store-subdomain
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# SHOPIFY_ADMIN_TOKEN=

# Planable (optional, Pro plan): Profile settings → Integrations → Public API
# PLANABLE_TOKEN=pln_...

# Scheduler: any long random string; the same value goes into supabase/schedule.sql
CRON_SECRET=

ETHER_TZ=America/Chicago
ETHER_WAKE_WORD=hey_jarvis
